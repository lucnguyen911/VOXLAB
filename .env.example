# VoxLab — Cấu hình môi trường Supabase License (Security v3)
# Sao chép tệp này thành `.env.local` và điền thông tin từ Supabase Project Settings -> API
VOXLAB_SUPABASE_URL=https://your-project-ref.supabase.co
VOXLAB_SUPABASE_ANON_KEY=your-public-anon-jwt-key

# Bật chế độ kiểm tra bản quyền bắt buộc lúc khởi động & trên tầng Rust (1 = bật, 0 = tắt)
VOXLAB_ENFORCE_LICENSE=1
VITE_VOXLAB_ENFORCE_LICENSE=1
